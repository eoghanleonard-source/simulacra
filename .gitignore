# Query outputs and exploration artefacts
*.csv
*.html
HANDOFF_*.md
dbt/models/snowflake_dsicovery.sql
*.jsonl
*.docx

# Seed data is pipeline input, not a query artefact — never let the rules above eat it,
# regardless of what extension a future seed file uses.
!dbt/seeds/**

# Customer-signal source-assessment pack (2026-10-07).
# Internal review material + a sanitised external handoff that has NOT been
# release-approved. Must not be committed or pushed. Remove this rule only
# after a release decision is recorded in the sanitisation manifest.
customer_signal_pack/

# Local previews, review decisions, and caches may contain client evidence.
output/
.training-cache/

# Project-local model runtime and generated demo evidence.
.venv-demo/
artifacts/demo/
.local/

# Isolated Training Studio UI environment.
.venv-mvp/

# Operator-local configuration and credentials (not source release material).
/local/

# Preserve tracked historical dbt seeds after the non-destructive archive move.
!archive/legacy/dbt/seeds/**

# Optional isolated dbt demonstration runtime.
.venv-source-grounded-dbt/

# Local credentials and developer/app state. Examples must use explicit safe names.
.env.*
**/.env
**/.env.*
